FROM node:22-alpine AS build

WORKDIR /app

COPY package*.json ./
# npm can omit native platform packages when a lockfile was generated on
# another OS (npm/cli#4828). Alpine needs musl binaries matching the build
# architecture (x64 on most CI runners, arm64 on Apple Silicon).
RUN npm ci \
    && case "$(uname -m)" in \
        x86_64) native_arch=x64 ;; \
        aarch64|arm64) native_arch=arm64 ;; \
        *) echo "Unsupported build architecture: $(uname -m)" >&2; exit 1 ;; \
    esac \
    && npm install --no-save \
        "@rollup/rollup-linux-${native_arch}-musl@4.60.4" \
        "@swc/core-linux-${native_arch}-musl@1.15.8"

COPY . .

# Vite substitutes public configuration while building the static bundle.
# These values cannot be injected later by the Nginx runtime container.
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_OPTIMIZER_URL=http://localhost:5005
ARG VITE_ML_URL=http://localhost:8000
ARG VITE_APNS_ENVIRONMENT=development
ARG VITE_LOG_LEVEL=info
ARG VITE_COMPLIANCE_BLOCKING_ENABLED=true
ARG VITE_COMPLIANCE_REJECTION_PERSIST=true
ARG VITE_DEMAND_ENGINE_MODE=ml_only
ARG VITE_DEMAND_SERVICE_LEVEL=0.5
ARG VITE_SENTRY_DSN
ARG VITE_SENTRY_ENVIRONMENT=production
ARG VITE_SENTRY_RELEASE
ARG VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
ARG VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
ARG VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0

ENV VITE_SUPABASE_URL=${VITE_SUPABASE_URL} \
    VITE_SUPABASE_ANON_KEY=${VITE_SUPABASE_ANON_KEY} \
    VITE_OPTIMIZER_URL=${VITE_OPTIMIZER_URL} \
    VITE_ML_URL=${VITE_ML_URL} \
    VITE_APNS_ENVIRONMENT=${VITE_APNS_ENVIRONMENT} \
    VITE_LOG_LEVEL=${VITE_LOG_LEVEL} \
    VITE_COMPLIANCE_BLOCKING_ENABLED=${VITE_COMPLIANCE_BLOCKING_ENABLED} \
    VITE_COMPLIANCE_REJECTION_PERSIST=${VITE_COMPLIANCE_REJECTION_PERSIST} \
    VITE_DEMAND_ENGINE_MODE=${VITE_DEMAND_ENGINE_MODE} \
    VITE_DEMAND_SERVICE_LEVEL=${VITE_DEMAND_SERVICE_LEVEL} \
    VITE_SENTRY_DSN=${VITE_SENTRY_DSN} \
    VITE_SENTRY_ENVIRONMENT=${VITE_SENTRY_ENVIRONMENT} \
    VITE_SENTRY_RELEASE=${VITE_SENTRY_RELEASE} \
    VITE_SENTRY_TRACES_SAMPLE_RATE=${VITE_SENTRY_TRACES_SAMPLE_RATE} \
    VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=${VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE} \
    VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=${VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE}

RUN test -n "$VITE_SUPABASE_URL" \
    && test -n "$VITE_SUPABASE_ANON_KEY"
RUN npm run build

FROM nginx:alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
