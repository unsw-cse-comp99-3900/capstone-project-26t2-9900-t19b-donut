# Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# SUPABASE CONFIGURATION (Required)
# =============================================================================

# Supabase project URL - Get from Supabase Dashboard > Settings > API
# Example: https://yourproject.supabase.co
VITE_SUPABASE_URL=

# Supabase anonymous/public key - Get from Supabase Dashboard > Settings > API
# This is safe to expose in the frontend bundle
VITE_SUPABASE_ANON_KEY=

# APNs gateway used by this iOS build. Use development for Xcode/debug builds
# and production for TestFlight/App Store builds.
VITE_APNS_ENVIRONMENT=development

# =============================================================================
# BUILD CONFIGURATION (Optional)
# =============================================================================

# Set to 'development' or 'production'
# Default: development
NODE_ENV=development

# Browser logging and compliance behavior.
VITE_LOG_LEVEL=info
VITE_COMPLIANCE_BLOCKING_ENABLED=true
VITE_COMPLIANCE_REJECTION_PERSIST=true

# Demand engine behavior. Supported modes: ml_only, rules_shadow, rules_primary.
VITE_DEMAND_ENGINE_MODE=ml_only
VITE_DEMAND_SERVICE_LEVEL=0.5

# =============================================================================
# LOCAL DOCKER SERVICES
# =============================================================================

# Base URL of the OR-Tools optimizer service.
# Default: http://localhost:5005 when running via docker-compose
VITE_OPTIMIZER_URL=http://localhost:5005

# Base URL of the FastAPI ML service (POST /predict/demand)
# Default: http://localhost:8000 when running via docker-compose
VITE_ML_URL=http://localhost:8000

# Maximum seconds run-prod.sh waits for every container to become healthy.
COMPOSE_WAIT_TIMEOUT=300

# Optimizer local settings.
OPTIMIZER_AUTH_DISABLED=true
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
OPTIMIZER_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173
OPTIMIZER_RATE_OPTIMIZE=30/minute
OPTIMIZER_RATE_AUDIT=60/minute
OPTIMIZER_MAX_CONCURRENT_SOLVES=2
WEB_CONCURRENCY=2
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=superman-optimizer

# Local-only authentication bypass for the ML HTTP service. The current browser
# client does not send a bearer token to ML. Never enable this on a public host.
ML_AUTH_DISABLED=true

# Required instead of the bypass when ML_AUTH_DISABLED=false. This is a
# server-side secret and must not be committed or prefixed with VITE_.
ML_JWT_SECRET=

# Comma-separated browser origins allowed to call the ML API.
ML_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173

# Verify model hashes against Supabase at startup when enabled.
ML_VERIFY_MANIFEST_HASHES=false

# Number of ML API worker processes.
UVICORN_WORKERS=4

# Optional server-side key used only by the ML container when committed demand
# forecasts must be persisted. Never rename this to start with VITE_, because
# VITE_ variables are embedded in the public browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# SENTRY (Optional — error monitoring)
# =============================================================================

# Public DSN — safe to expose in the bundle. Errors are reported only when set.
# Get from Sentry Dashboard > Project Settings > Client Keys (DSN).
VITE_SENTRY_DSN=

# Environment label shown on each event ("production", "staging", etc.).
# Falls back to Vite's MODE if unset.
VITE_SENTRY_ENVIRONMENT=

# Release identifier — typically the git SHA. Set in CI.
VITE_SENTRY_RELEASE=

# Sampling rates (0.0 – 1.0). Defaults: traces=0.1, replay=0, replay-on-error=1.
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0

# Build-time source-map upload (CI only — never commit these).
# Without these vars, the build still succeeds; uploads are skipped.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# =============================================================================
# NOTES
# =============================================================================
# - Never commit .env with real values to version control
# - The Supabase Service Role Key should NEVER be used in the frontend
# - Edge functions use SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY from Supabase's
#   built-in environment (automatically injected, do not set manually)
